// 部品（src/scenes・src/components）に色を直接書かない（AGENTS.md の決まり）
// 色は講座のテーマから取る（部品の頭で const { C, tone, SYNTAX } = usePalette() と書いて読む。src/theme.ts。テーマの仕様は .claude/skills/study-video-course/references/theme.md）。
// 見るもの: 文字列・JSX の属性・テンプレート文字列の中の 16 進の色（#fff・#FFFFFF など）と rgb()・rgba()・hsl()・hsla()。
// 誤り（error）にする（今あった直書きは、色をトークンにするタスク T3A-05 で片付けた）。
//
// 理由のある例外（テーマではなく「そのものの色」を描くとき。架空のアプリの画面・スマホの枠・窓の信号）は、src/components/app-colors.ts にだけ書き、
// 理由を書いた抑止のコメントで示す。理由の無い抑止は書かない。
//   1 か所:   // biome-ignore lint/plugin/no-hardcoded-color: <理由>
//   まとまり: // biome-ignore-start lint/plugin/no-hardcoded-color: <理由>
//             （パレットの定義）
//             // biome-ignore-end lint/plugin/no-hardcoded-color: <理由>
// 対象のファイルは biome.jsonc の plugins の includes で決める。
language js

or {
  JsStringLiteralExpression() as $literal,
  JsxString() as $literal,
  JsTemplateChunkElement() as $literal
} where {
  $literal <: r"(?s).*(?:#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\b|(?:rgba?|hsla?)\().*",
  register_diagnostic(
    span = $literal,
    message = "部品に色を直接書かない。テーマ（usePalette() の C・TONES など）から取る。理由のある例外は biome-ignore lint/plugin/no-hardcoded-color のコメントに理由を書く。",
    severity = "error"
  )
}
