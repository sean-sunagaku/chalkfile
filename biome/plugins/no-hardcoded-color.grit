// 部品（src/scenes・src/components）に色を直接書かない（CLAUDE.md の決まり）
// 色は講座のテーマから取る（src/theme.ts の C・TONES・SYNTAX など。テーマの仕様は .claude/skills/study-video-course/references/theme.md）。
// 見るもの: 文字列・JSX の属性・テンプレート文字列の中の 16 進の色（#fff・#FFFFFF など）と rgb()・rgba()・hsl()・hsla()。
// 今は警告だけにする（今ある直書きは、色をトークンにするタスク T3A-05 で片付けてから、error にする）。
//
// 理由のある例外（テーマではなく「そのものの色」を描くとき。例: src/scenes/mock.tsx の M は架空のアプリの色）は、
// 理由を書いた抑止のコメントで示す。理由の無い抑止は書かない（M には、場面を 1 種類 1 ファイルに分ける作業のあとで付ける）。
//   1 か所:   // biome-ignore lint/plugin/no-hardcoded-color: <理由>
//   まとまり: // biome-ignore-start lint/plugin/no-hardcoded-color: <理由>
//             （パレットの定義）
//             // biome-ignore-end lint/plugin/no-hardcoded-color: <理由>
// 対象のファイルは biome.jsonc の plugins の includes で決める。
language js

or {
  JsStringLiteralExpression() as $literal,
  JsxString() as $literal,
  JsTemplateChunkElement() as $literal
} where {
  $literal <: r"(?s).*(?:#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\b|(?:rgba?|hsla?)\().*",
  register_diagnostic(
    span = $literal,
    message = "部品に色を直接書かない。テーマ（src/theme.ts の C・TONES など）から取る。理由のある例外は biome-ignore lint/plugin/no-hardcoded-color のコメントに理由を書く。",
    severity = "warn"
  )
}
