// Biome の設定（TS・TSX・JSON の lint と整形）。コメントを書くので biome.jsonc にしている
//   npm run lint        lint・整形・import の並べ替えを確かめる（CI の check でも流す）
//   npm run format:new  足したファイルだけを整形する（CI の pull_request は、足したファイルの整形を確かめる）
//   npm run format      整形・import の並べ替えと lint の安全な直し
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
  "files": {
    "ignoreUnknown": true,
    // 対象: 動画（src）・台本（content）・道具（scripts）・サイトの TS・Worker・テスト・設定の JSON
    // HTML（site/template.html・site/home.html）と CSS は当面は見ない（画面の JS を TS に出したあとで見直す）
    "includes": [
      "src/**",
      "engine/**",
      "content/**",
      "scripts/**",
      "site/*.ts",
      "site/lib/*.ts",
      "site/page/*.ts",
      "site/*.json",
      "worker/**",
      "tests/**",
      "tools/verify/**",
      "*.ts",
      "*.json",
      "*.jsonc",
      ".claude/launch.json",
      // 生成物（講座のフォルダの generated と、書体のサブセット engine/fonts（npm run fonts が作る）。手で直さない。作り直す）と、テストの記録（そのままの形で残す）
      "!content/*/generated",
      "!engine/fonts",
      "!engine/core/project-settings.ts",
      "!scripts/audio/video_config.json",
      // Worker の型は wrangler types が作る（npm run gen:worker-types）。Worker の許可リストは npm run gen が作る（Git に入れない）
      "!worker/worker-configuration.d.ts",
      "!worker/src/generated/*.json",
      "!tests/fixtures",
      "!package-lock.json"
    ]
  },
  // 整形: 書き方は今の多数派に合わせる（シングルクォート・セミコロン・2 スペース・末尾のカンマ）。
  // 行幅は 120（content を除くコードの行の 92% が 120 字以内。100 字以内は 88%、80 字以内は 80%。2026-11-02 に数えた）
  // 全体の整形を入れた commit は .git-blame-ignore-revs に記録する。以後は CI で全体の整形も確かめる。
  "formatter": {
    "enabled": true,
    // 台本（content）は lint だけにする。台本の 1 行は長く、整形すると差分が大きく、講座の PR と必ずぶつかる
    "includes": ["**", "!content/**"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  // import の並べ替えも、全体の整形と同じ日に入れる
  "assist": { "enabled": true },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      // Playwright の規則は tests/e2e と tools/verify だけで使う（下の overrides）。scripts の describe() を Playwright のものと取り違えるため
      "playwright": "none"
    },
    "rules": { "preset": "recommended" }
  },
  "plugins": [
    // 描画と台本で、乱数・今の時刻を使わない（error）
    { "path": "./biome/plugins/no-nondeterminism.grit", "includes": ["src/**", "content/**"] },
    // 部品に色を直接書かない（error。そのものの色は src/components/app-colors.ts に、理由を書いた抑止で書く）
    { "path": "./biome/plugins/no-hardcoded-color.grit", "includes": ["src/scenes/**", "src/components/**"] }
  ],
  "overrides": [
    {
      // 動画の描画（Remotion）。画面は動画の絵になるだけで、人が DOM を操作しない
      "includes": ["src/**"],
      "linter": {
        "rules": {
          // 支援技術が DOM を読まない（読むのは講座サイトの側）
          "a11y": "off",
          "suspicious": {
            // 場面の項目は台本のとおりに並び、描いている間に並びが変わらない。添字の key で困らない
            "noArrayIndexKey": "off",
            // コードの場面の文字幅の見積もりで、ASCII（0x00〜0x7F）かどうかを見る正規表現（意図した書き方）。
            // src/scenes は別の作業（場面を 1 種類 1 ファイルに分ける）で動いているので、ここでは直さずに warn にする。
            // 分けたあとで、その行に理由を書いて抑止し（biome-ignore lint/suspicious/noControlCharactersInRegex）、この行を消す
            "noControlCharactersInRegex": "warn"
          }
        }
      }
    },
    {
      // エンジンの部品（engine/core）は、React・Remotion・Node（fs・crypto など）・中身（content/）・動画（src/）・道具（scripts/）に依存しない。
      // 読んでよいのは同じフォルダのファイル（./）だけ（型も）。中身の値が要るとき（テーマの一覧など）は、呼ぶ側が引数で渡す。
      // 台本（content/）と一緒に取り出して読む道具がある（scripts/reading-diff.ts・scripts/materials.ts の gc）ので、外を読むと壊れる
      "includes": ["engine/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./*"],
                    "message": "engine/core は engine/core の中（./ のファイル）だけを読む。React・Remotion・Node・content/・src/・scripts/ を読まない（中身の値は、呼ぶ側が引数で渡す）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // 台本（content/）が読んでよいのは、content/ の中（講座の中・講座どうし・content/types.ts などの共通のファイル）と engine/core/ だけ。
      // 動画（src/）・道具（scripts/）・サイト（site/）・npm のパッケージ・Node を読まない（型も）。取り出して読む道具（scripts/reading-diff.ts・
      // scripts/materials.ts の gc）は content/ と engine/core/ だけを取り出す。パスの深さで、content/ の外に出る ../ の数が違うので、深さごとに書く
      "includes": ["content/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./**", "../**", "!../engine/core/**"],
                    "message": "台本（content/）が読んでよいのは、content/ の中（講座の中・講座どうし・content/ の共通のファイル）と engine/core/ だけ。src/・scripts/・site/・npm のパッケージ・Node を読まない"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["content/*/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./**", "!../**", "../../**", "!../../engine/core/**"],
                    "message": "台本（content/）が読んでよいのは、content/ の中（講座の中・講座どうし・content/ の共通のファイル）と engine/core/ だけ。src/・scripts/・site/・npm のパッケージ・Node を読まない"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["content/*/*/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./**", "!../**", "../../../**", "!../../../engine/core/**"],
                    "message": "台本（content/）が読んでよいのは、content/ の中（講座の中・講座どうし・content/ の共通のファイル）と engine/core/ だけ。src/・scripts/・site/・npm のパッケージ・Node を読まない"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // 動画（src/）が中身（content/）を読むのは src/project.ts だけ（次の override）。場面と部品は、描くものを props と context で受け取る。
      // 道具（scripts/）も読まない（向きが逆）。src/components/content.tsx（内容の枠の部品）は ./ か ../components/ から読むので当たらない
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../content", "../content/**", "../../content", "../../content/**"],
                    "message": "src/ で中身（content/）を読むのは src/project.ts だけ。型は engine/core/schema.ts、値は project（createRoot に渡す一式）から受け取る"
                  },
                  {
                    "group": ["../scripts/**", "../../scripts/**"],
                    "message": "動画（src/）は道具（scripts/）を読まない（道具が動画の部品を読む向きもしない）。両方で使うものは engine/core/ に置く"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // 中身とのつなぎ（src/project.ts）だけは content/ を読む
      "includes": ["src/project.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      // 道具（scripts/）は、動画（src/）の内部を読まない。動画と道具の両方で使う値と関数は engine/core/ に置く（動画の決まった値は
      // engine/core/video-config.ts）。動画を書き出すときは、src/index.ts をバンドルの入口として渡す（import しない）
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../src", "../src/**", "../../src", "../../src/**", "../../../src", "../../../src/**"],
                    "message": "道具（scripts/）は動画（src/）の内部を読まない。両方で使うものは engine/core/ から読む（動画の決まった値は engine/core/video-config.ts）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tests/e2e/**", "tools/verify/**", "playwright.config.ts"],
      "linter": { "domains": { "playwright": "recommended" } }
    },
    {
      // 旧 Pages の移行のコード。期限に消すまで凍結する（変えない。docs/adr/2026-11-02-legacy-pages-end-date.md・tests/unit/legacy-freeze.test.ts）。
      // 全体の整形の日にも整形しない
      "includes": ["site/legacy-sw.ts", "scripts/build_migration.ts", "site/legacy-config.json"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // 別の PR（#30）が直している最中なので、ここでは直さない。#30 が入ったあとに直すか、理由を書いて抑止する
      // CONTROL の正規表現は、制御文字を見つけるための意図した書き方
      "includes": ["scripts/check_content.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noControlCharactersInRegex": "warn", "useIterableCallbackReturn": "warn" }
        }
      }
    }
  ]
}
