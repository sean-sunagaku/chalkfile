{
  "name": "chalkfile",
  "version": "1.0.0",
  "private": true,
  "description": "台本（コード）から、ナレーション付きの講座動画と講座サイトを作る（Remotion・VOICEVOX・GitHub Pages）",
  "scripts": {
    "studio": "remotion studio",
    "synth": "bun scripts/synth.ts",
    "render": "bash scripts/render.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json",
    "test": "bun test tests/offline.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@remotion/cli": "4.0.440",
    "@remotion/google-fonts": "4.0.440",
    "lucide-react": "^0.511.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.440"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.14",
    "typescript": "6.0.2"
  }
}
