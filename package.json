{
  "name": "chalkfile",
  "version": "1.0.0",
  "private": true,
  "description": "台本（コード）から、ナレーション付きの講座動画と講座サイトを作る（Remotion・VOICEVOX・Cloudflare Workers）",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test && npm run validate && npm run check:content && npm run check:docs && npm run check:materials",
    "lint": "biome ci --formatter-enabled=false --assist-enabled=false",
    "lint:py": "uvx ruff@0.17.3 check scripts",
    "lint:sh": "shellcheck --exclude=SC2086 scripts/render.sh && git ls-files -z '*.sh' ':!scripts/render.sh' | xargs -0 shellcheck",
    "knip": "knip",
    "format": "biome check --write",
    "format:new": "bun scripts/format_new.ts --write",
    "typecheck": "npm run typecheck:worker-types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p site/tsconfig.client.json && tsc --noEmit -p site/tsconfig.sw.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tests/tsconfig.bun.json",
    "typecheck:worker-types": "bun scripts/worker_types.ts",
    "gen:worker-types": "bun scripts/worker_types.ts --write",
    "test": "bun test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:browser": "playwright test",
    "check:content": "bun scripts/check_content.ts --self-test && bun scripts/check_content.ts",
    "check:docs": "bun scripts/check_docs.ts",
    "check:materials": "bun scripts/build_materials.ts --check",
    "validate": "bun scripts/validate.ts",
    "gen": "bun scripts/gen.ts",
    "gen:video-config": "bun scripts/gen_video_config.ts",
    "build:music": "uv run --locked --group audio python scripts/build_music.py",
    "synth": "bun scripts/synth.ts",
    "mix": "uv run --locked --group audio python scripts/mix.py",
    "render": "bash scripts/render.sh",
    "stills": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stills.ts",
    "stills:compare": "bun scripts/stills-compare.ts",
    "studio": "remotion studio",
    "build:materials": "bun scripts/build_materials.ts",
    "build:site": "bun scripts/build_site.ts",
    "serve": "bun scripts/serve.ts",
    "dev:worker": "bun scripts/gen.ts --media && wrangler dev",
    "materials:pull": "bun scripts/materials.ts pull",
    "materials:check": "bun scripts/materials.ts check",
    "materials:push": "bun scripts/materials.ts push",
    "media:check": "bun scripts/media.ts check",
    "media:push": "bun scripts/media.ts push"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "lucide-react": "0.511.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/bun": "1.3.6",
    "@types/react": "19.3.0",
    "knip": "6.44.1",
    "typescript": "6.0.3",
    "wrangler": "4.156.1"
  }
}
