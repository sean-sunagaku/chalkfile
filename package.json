{
  "name": "chalkfile",
  "version": "1.0.0",
  "private": true,
  "description": "台本（コード）から、ナレーション付きの講座動画と講座サイトを作る（Remotion・VOICEVOX・Cloudflare Workers）",
  "packageManager": "npm@12.2.1",
  "bin": {
    "chalkfile": "scripts/cli.ts"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "chalk": "bun scripts/cli.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate && npm run check:content && npm run check:docs && npm run check:materials",
    "lint": "biome ci",
    "lint:py": "uvx ruff@0.17.3 check scripts",
    "lint:sh": "git ls-files -z '*.sh' | xargs -0 shellcheck",
    "knip": "knip",
    "format": "biome check --write",
    "format:new": "bun scripts/format_new.ts --write",
    "typecheck": "npm run typecheck:worker-types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p site/tsconfig.client.json && tsc --noEmit -p site/tsconfig.sw.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tests/tsconfig.bun.json && tsc --noEmit -p tools/verify/tsconfig.json && tsc --noEmit -p tests/tsconfig.legacy.json && tsc --noEmit -p site/tsconfig.legacy-sw.json",
    "typecheck:worker-types": "bun scripts/worker_types.ts",
    "gen:worker-types": "bun scripts/worker_types.ts --write",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:browser": "playwright test",
    "test:e2e:ci": "playwright test --project=ci",
    "test:e2e:real": "playwright test --project=real",
    "check:content": "bun scripts/check_content.ts --self-test && bun scripts/check_content.ts",
    "check:docs": "bun scripts/check_docs.ts",
    "check:materials": "bun scripts/build_materials.ts --check",
    "validate": "bun scripts/validate.ts",
    "i18n": "bun scripts/i18n.ts",
    "reading:diff": "bun scripts/reading-diff.ts",
    "gen": "bun scripts/gen.ts",
    "gen:video-config": "bun scripts/gen_video_config.ts",
    "build:music": "uv run --locked --group audio python scripts/build_music.py",
    "music:verify": "uv run --locked --group audio python scripts/build_music.py --check",
    "synth": "bun scripts/synth.ts",
    "mix": "bun scripts/cli.ts mix",
    "render": "bun scripts/cli.ts render",
    "fonts": "bun scripts/fonts.ts",
    "stills": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stills.ts",
    "stills:compare": "bun scripts/stills-compare.ts",
    "studio": "remotion studio",
    "build:materials": "bun scripts/build_materials.ts",
    "build:site": "bun scripts/build_site.ts",
    "serve": "bun scripts/serve.ts",
    "dev:worker": "bun scripts/gen.ts --media && wrangler dev",
    "materials:pull": "bun scripts/materials.ts pull",
    "materials:check": "bun scripts/materials.ts check",
    "materials:push": "bun scripts/materials.ts push",
    "media:check": "bun scripts/media.ts check",
    "media:push": "bun scripts/media.ts push",
    "worktree:new": "bun scripts/worktree.ts",
    "clean": "bun scripts/clean.ts",
    "codemod:content": "bun scripts/codemod_content.ts",
    "verify:site": "bun tools/verify/worker-site-smoke.ts",
    "verify:worker": "bun tools/verify/smoke_worker.ts",
    "format:py": "uvx ruff@0.17.3 format scripts",
    "format:py:check": "uvx ruff@0.17.3 format --check scripts",
    "snapshots:update": "bun scripts/snapshots.ts --update",
    "media:pull": "bun scripts/media.ts pull",
    "deploy:worker": "bun scripts/deploy_worker.ts",
    "verify:production": "bun tools/verify/verify-production.ts",
    "measure:production": "bun tools/verify/measure-production.ts",
    "verify:safari": "bun tools/verify/verify-safari.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/layout-utils": "4.0.540",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "7.24.1",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@remotion/bundler": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "jsonc-parser": "3.3.1",
    "knip": "6.44.1",
    "typescript": "7.0.2",
    "wrangler": "4.156.1"
  }
}
